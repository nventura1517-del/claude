# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any real secrets.

# --- Supabase (public, safe to expose to the browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Supabase service role (SERVER ONLY — never prefix with NEXT_PUBLIC) ---
# Used only in server code for privileged operations (invite acceptance, etc.).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Resend transactional email (SERVER ONLY) ---
RESEND_API_KEY=your-resend-api-key
# Verified sending address, e.g. "Homeward <hello@yourdomain.com>"
EMAIL_FROM=Homeward <onboarding@resend.dev>

# --- App ---
# Public base URL, used to build invite links. e.g. http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
